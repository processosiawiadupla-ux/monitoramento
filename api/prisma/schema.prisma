generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- ENUMS ----------------

enum Role {
  ADMIN
  GESTOR
  VENDEDOR
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthor {
  CONTACT
  USER
  BOT
}

enum RuleTrigger {
  FIRST_REPLY       // primeira resposta da vendedora
  INBOUND_KEYWORD   // palavra na mensagem do cliente
  OUTBOUND_KEYWORD  // palavra na mensagem da vendedora
}

// ---------------- MODELOS ----------------

model Organization {
  id              String           @id @default(cuid())
  name            String
  responseAlertMinutes Int              @default(30)
  createdAt       DateTime         @default(now())

  users           User[]
  stages          Stage[]
  contacts        Contact[]
  conversations   Conversation[]
  whatsappNumbers WhatsAppNumber[]
  stageRules      StageRule[]
}

model User {
  id                    String           @id @default(cuid())
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  email                 String           @unique
  passwordHash          String
  role                  Role             @default(VENDEDOR)
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  assignedConversations Conversation[]   @relation("AssignedTo")
  sentMessages          Message[]
  stageChanges          StageChange[]
  ownedNumbers          WhatsAppNumber[] @relation("NumberOwner")

  @@index([organizationId])
}

model WhatsAppNumber {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phone           String
  label           String
  ownerId         String?
  owner           User?          @relation("NumberOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  waPhoneNumberId String?        @unique
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())

  conversations   Conversation[]

  @@unique([organizationId, phone])
}

model Stage {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String         @default("#5B636B")
  position       Int
  kind           StageKind      @default(OPEN)
  archived       Boolean        @default(false)
  createdAt      DateTime       @default(now())

  conversations  Conversation[] @relation("CurrentStage")
  aiSuggestedFor Conversation[] @relation("AiSuggestedStage")
  changesFrom    StageChange[]  @relation("FromStage")
  changesTo      StageChange[]  @relation("ToStage")
  rules          StageRule[]

  @@index([organizationId, position])
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phone          String
  name           String?
  createdAt      DateTime       @default(now())

  conversations  Conversation[]

  @@unique([organizationId, phone])
}

model Conversation {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stageId            String
  stage              Stage           @relation("CurrentStage", fields: [stageId], references: [id], onDelete: NoAction)
  whatsappNumberId   String?
  whatsappNumber     WhatsAppNumber? @relation(fields: [whatsappNumberId], references: [id], onDelete: SetNull)
  assignedToId       String?
  assignedTo         User?           @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  estimatedValue     Decimal?        @db.Decimal(12, 2)
  lastMessageAt      DateTime        @default(now())
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  aiSuggestedStageId String?
  aiSuggestedStage   Stage?          @relation("AiSuggestedStage", fields: [aiSuggestedStageId], references: [id], onDelete: SetNull)
  aiSuggestionReason String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  messages           Message[]
  stageChanges       StageChange[]

  @@index([organizationId, stageId])
  @@index([organizationId, assignedToId])
  @@index([whatsappNumberId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  author         MessageAuthor
  body           String           @db.Text
  waMessageId    String?          @unique
  sentById       String?
  sentBy         User?            @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model StageChange {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromStageId    String?
  fromStage      Stage?       @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId      String
  toStage        Stage        @relation("ToStage", fields: [toStageId], references: [id], onDelete: NoAction)
  changedById    String?
  changedBy      User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  byAi           Boolean      @default(false)
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model StageRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  trigger        RuleTrigger
  keywords       String[]
  toStageId      String
  toStage        Stage        @relation(fields: [toStageId], references: [id], onDelete: Cascade)
  position       Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}